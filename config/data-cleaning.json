{
  "version": 1,
  "rules": "rules/banned-words-quick.yaml",
  "scan_fields": [
    "body",
    "cover_ocr",
    "tags"
  ],
  "model_context_fields": [
    "title",
    "body",
    "cover_ocr",
    "tags"
  ],
  "profiles": {
    "xhs": {
      "platform": "xhs",
      "input_dir": "data/xhs",
      "policy_flags": {
        "platform_allows_api": false
      },
      "high_metrics": {
        "likes": 50,
        "collects": 20
      },
      "interaction_metrics": [
        "likes",
        "collects",
        "comments"
      ]
    },
    "xianyu": {
      "platform": "xianyu",
      "input_dir": "data/xianyu",
      "policy_flags": {
        "platform_allows_api": false
      },
      "ranked_file": "data/xianyu/_ranked.md",
      "wants_field": "wants",
      "top_count": 5,
      "reference_count": 14,
      "ranked_entry_pattern": "(?m)^\\d+\\. .*?—\\s*([0-9,]+)\\s*人想要\\s*\\n\\s*https?://[^\\s]+[?&]id=([^&\\s]+)"
    }
  },
  "audience": {
    "raw_field": "audience_raw",
    "output_field": "audience",
    "list_pattern": "适合人群\\s*[：:]\\s*(.+)",
    "separator_pattern": "[、，,；;\\n]+"
  },
  "posts_file": "data/posts.jsonl",
  "migration_expected_counts": {
    "xhs": 364,
    "xianyu": 34
  },
  "migration_indexes": [
    {
      "platform": "xhs",
      "index": "data/xhs/_notes-index.json",
      "urls": "data/xhs/_urls.txt"
    }
  ],
  "monitoring": {
    "recent_days": 7,
    "metrics_max_age_days": 3,
    "minimum_age_hours": 24,
    "metric_weights": {
      "likes": 1,
      "collects": 2,
      "comments": 1.5
    },
    "age_decay": 0.5,
    "growth_weight": 0.2,
    "minimum_peer_count": 5,
    "minimum_interactions": 10,
    "heat_weight": 2,
    "hot_percentile": 0.8,
    "history_limit": 30,
    "title_similarity": 0.85,
    "body_similarity": 0.78
  }
}

# Copy to scratch/gateway.env on each computer, then fill the existing company key.
# Never commit a populated credential file.
CONTENT_OPS_API_KEY=
CONTENT_OPS_BASE_URL=https://duoyuanx.com/v1
CONTENT_OPS_TEXT_MODEL=claude-sonnet-4-6
CONTENT_OPS_VISION_MODEL=claude-sonnet-4-6
CONTENT_OPS_IMAGE_MODEL=qwen-image-3.0
CONTENT_OPS_ANALYSIS_MODEL=claude-sonnet-4-6
# New batches: copy structure and number of copies per image (1–5).
CONTENT_OPS_COPY_FORMAT=all_variations
CONTENT_OPS_COPY_MULTIPLIER=3

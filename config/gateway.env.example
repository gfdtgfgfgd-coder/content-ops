# Copy to scratch/gateway.env on each computer, then fill the existing company key.
# Never commit a populated credential file.
CONTENT_OPS_API_KEY=
CONTENT_OPS_BASE_URL=https://duoyuanx.com/v1
# Model defaults are read by both Hanabi and the generation CLI from this template.
CONTENT_OPS_TEXT_MODEL=gemini-3.8-flash
CONTENT_OPS_VISION_MODEL=gpt-6.1-terra
CONTENT_OPS_IMAGE_MODEL=gpt-image-2.6-sunburst
CONTENT_OPS_ANALYSIS_MODEL=deepseek-v4.1-flash-1017
# New batches: copy structure and number of copies per image (1–5).
CONTENT_OPS_COPY_FORMAT=all_variations
CONTENT_OPS_COPY_MULTIPLIER=3

# Merge copy requests across images (1–10); automatically bounded to six copies per call.
CONTENT_OPS_COPY_CHUNK_IMAGES=2
